# Copy this file to .env in the repo root:  cp .env.example .env
# Then fill in your OWN credentials below. Never commit the real .env.
#
# You bring your own data and your own API keys. Nothing in this repo is
# tied to a specific account -- point these at your own services.

# ---- Qdrant (vector store, https://cloud.qdrant.io or self-hosted) ----------
QDRANT_URL="https://YOUR-CLUSTER-ID.eu-central.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key-here"
QDRANT_COLLECTION="my_books_hybrid"

# ---- Voyage AI (embeddings, https://dash.voyageai.com) ---------------------
VOYAGE_API_KEY="your-voyage-api-key-here"

# ---- Google AI Studio (generator LLM, https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"

# ---- Redis (semantic cache; RediSearch/HNSW required) ----------------------
# NOTE: some managed Redis instances need REDIS_SSL=false even though the SDK
# default is true -- if the SSL handshake times out, flip this to false.
REDIS_HOST="your-redis-host.example.com"
REDIS_PORT="12345"
REDIS_USERNAME="default"
REDIS_PASSWORD="your-redis-password-here"
REDIS_SSL="false"

# ---- Opik / Comet ML (optional tracing, https://www.comet.com/opik) --------
# Optional: feedback degrades to scripts/feedback.jsonl if these are missing.
OPIK_API_KEY="your-opik-api-key-here"
OPIK_WORKSPACE="your-opik-workspace"
OPIK_PROJECT_NAME="bilingual-crag-assistant"

# ---- Tavily (optional web-search fallback, https://app.tavily.com) ----------
# Optional: CRAG falls back to a DB-only honest refusal if this is missing.
TAVILY_API_KEY="your-tavily-api-key-here"

# ---- Tech defaults (rarely need to change) ---------------------------------
SPARSE_MODEL="Qdrant/bm25"
CACHE_DISTANCE_THRESHOLD="0.20"
CONVERSATION_WINDOW_SIZE="4"
CONVERSATION_SESSION_TTL="3600"
CRAG_THRESHOLD="0.45"
PER_CHUNK_THRESHOLD="0.5"
